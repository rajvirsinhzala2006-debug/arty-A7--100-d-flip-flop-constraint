## Arty A7-100 constraints for d_ff_dataflow

## Clock (push button BTN0, one press = one clock edge)
set_property -dict { PACKAGE_PIN D9    IOSTANDARD LVCMOS33 } [get_ports { clk }];

## Data input (switch SW0)
set_property -dict { PACKAGE_PIN A8    IOSTANDARD LVCMOS33 } [get_ports { d }];

## Outputs (LEDs)
set_property -dict { PACKAGE_PIN H5    IOSTANDARD LVCMOS33 } [get_ports { q }];
set_property -dict { PACKAGE_PIN J5    IOSTANDARD LVCMOS33 } [get_ports { qn }];

## Needed because the button is not a dedicated clock pin
set_property CLOCK_DEDICATED_ROUTE FALSE [get_nets clk_IBUF]

## Needed because the latches are built from cross-coupled gates (combinational loops)
set_property SEVERITY {Warning} [get_drc_checks LUTLP-1]
set_property ALLOW_COMBINATORIAL_LOOPS TRUE [get_nets -hierarchical *]
